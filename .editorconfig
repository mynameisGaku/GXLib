root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,c}]
indent_size = 4

[*.{hlsl,hlsli}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{sln,vcxproj,vcxproj.filters,props}]
end_of_line = crlf
indent_style = tab
